page { background: #faf8f4; color: #293b35; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; }
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; font-size: 28rpx; line-height: 1.5; border-radius: 24rpx; background: transparent; color: inherit; }
button::after { border: none; }
button[disabled] { opacity: .4; color: inherit; }
