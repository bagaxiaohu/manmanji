.app { padding: 32rpx 36rpx 180rpx; max-width: 1000rpx; margin: 0 auto; }
.brand-row,.row-between,.study-top,.card-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.brand { display:block; font-size:39rpx; font-weight:650; letter-spacing:3rpx; }.brand-flower { color:#a4b495; }.brand-caption { display:block; font-size:20rpx; color:#8a938b; margin-top:6rpx; letter-spacing:2rpx; }
.settings-button { padding:14rpx 22rpx; border:1rpx solid #e0e4d9; font-size:24rpx; }.greeting { margin:60rpx 0 36rpx; }.eyebrow { display:block; font-size:20rpx; letter-spacing:2rpx; color:#899485; }
.heading { font-size:45rpx; font-weight:600; line-height:1.6; margin:18rpx 0 12rpx; letter-spacing:1rpx; }.subheading { color:#92978b; font-size:25rpx; line-height:1.8; }
.daily-card { background:#365747; border-radius:32rpx; padding:32rpx; color:#fffaf0; }.pill { display:inline-block; background:#edf0e7; color:#627b64; font-size:19rpx; border-radius:12rpx; padding:9rpx 14rpx; letter-spacing:1rpx; }.pill.light { color:#e4ebdb; background:#506d59; font-size:18rpx; }
.small-light { color:#c3d0bb; font-size:22rpx; display:block; }.daily-title { margin:28rpx 0; font-size:29rpx; }.daily-numbers { display:flex; align-items:center; margin-bottom:28rpx; }.daily-numbers>view { flex:1; }.daily-numbers .due-count { border-left:1rpx solid #718474; padding-left:40rpx; flex:0.7; }.number { display:block; font-size:70rpx; line-height:1.3; font-weight:500; }.number-unit { font-size:30rpx; color:#aebfa8; }
.track { height:10rpx; background:#e4e9dd; border-radius:20rpx; overflow:hidden; }.fill { height:100%; background:#69866a; border-radius:20rpx; transition:width .25s; }.light-track { background:#55715b; height:7rpx; }.light-fill { background:#d7e4bd; }
.cream-button { display:flex; justify-content:space-between; padding:24rpx 30rpx; background:#f2eddc; color:#355340; font-weight:600; margin-top:32rpx; border-radius:18rpx; }
.mini-stats { display:flex; justify-content:space-around; text-align:center; margin:36rpx 0 52rpx; }.mini-stats>view,.milestones>view { display:flex; flex-direction:column; gap:10rpx; }.stat-number { font-size:41rpx; font-weight:550; }.unit { font-size:22rpx; font-weight:400; color:#939a8f; }.muted { color:#93998e; font-size:23rpx; line-height:1.7; }
.section-title { font-size:28rpx; font-weight:600; margin:36rpx 0 24rpx; }.no-margin { margin:0; }.shortcut-row { display:flex; gap:20rpx; }.shortcut { flex:1; padding:28rpx 24rpx; background:#edf0e6; border-radius:26rpx; text-align:left; }.peach { background:#f4ece2; }.shortcut-icon { display:block; font-size:40rpx; color:#718367; line-height:1; margin-bottom:22rpx; }.shortcut-title { display:block; font-size:28rpx; font-weight:550; margin-bottom:10rpx; }
.note { display:flex; align-items:flex-start; gap:20rpx; padding:32rpx 12rpx; margin-top:24rpx; color:#7d8976; font-size:25rpx; line-height:1.9; }.note-flower { color:#acb496; font-size:34rpx; }.home-footer { display:block; text-align:center; color:#b1b3a4; font-size:20rpx; margin-top:20rpx; letter-spacing:2rpx; }
.tabbar { position:fixed; bottom:0; left:0; right:0; display:flex; padding:14rpx 30rpx calc(14rpx + env(safe-area-inset-bottom)); background:#faf8f4; border-top:1rpx solid #e9e9df; z-index:5; }.tab { flex:1; color:#a2a69a; display:flex; flex-direction:column; align-items:center; gap:2rpx; font-size:21rpx; padding:6rpx; }.tab-icon { font-size:38rpx; line-height:1.2; }.tab-active { color:#3f654c; }
.page-intro { margin:50rpx 0 30rpx; }.page-intro .heading { font-size:37rpx; }.search { background:#eeeee5; padding:24rpx 28rpx; height:88rpx; border-radius:20rpx; font-size:26rpx; }.filter-rows { margin:24rpx 0 10rpx; display:flex; flex-direction:column; gap:14rpx; }.filter-row { display:flex; gap:14rpx; width:100%; }.chip { flex:1; min-width:0; width:0; padding:13rpx 22rpx; font-size:23rpx; color:#87927f; border:1rpx solid #dfe4d8; border-radius:40rpx; }.selected { background:#3e604c; color:#fff; border-color:#3e604c; }.library-meta { margin:24rpx 0 10rpx; }.text-button { font-size:24rpx; padding:12rpx 4rpx; color:#89947f; }.green-text { color:#3f654c; }
.word-row { display:flex; gap:12rpx; align-items:flex-start; padding:26rpx 0; border-bottom:1rpx solid #e8e9df; }.word-row-main { flex:1; min-width:0; }.row-word { font-size:35rpx; color:#354839; overflow-wrap:anywhere; }.learned-dot { color:#93a184; font-size:19rpx; }.row-phonetic { display:block; color:#949c8f; font-size:23rpx; margin:9rpx 0; }.row-meaning { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; font-size:25rpx; line-height:1.7; color:#737e6c; }.row-group { display:block; font-size:19rpx; color:#a1a991; margin-top:14rpx; }.star { padding:8rpx; color:#9ca68d; font-size:42rpx; line-height:1; min-width:64rpx; min-height:64rpx; }.star.active { color:#b99759; }.empty,.list-end { color:#929b86; padding:60rpx 0; text-align:center; font-size:24rpx; }.load-more { padding:30rpx; color:#6d8263; margin-top:16rpx; }
.progress-card { background:#eef1e7; border-radius:28rpx; padding:32rpx; margin-top:36rpx; }.progress-number { font-size:64rpx; margin:28rpx 0; }.progress-caption { font-size:21rpx; line-height:1.7; color:#8f9d81; margin-top:20rpx; }.chart { display:flex; background:#fffdf7; padding:28rpx 12rpx; border-radius:26rpx; }.bar-column { flex:1; display:flex; flex-direction:column; align-items:center; }.bar-number { font-size:22rpx; color:#829374; }.bar-space { height:140rpx; display:flex; align-items:flex-end; padding-bottom:10rpx; }.bar { width:32rpx; border-radius:10rpx 10rpx 3rpx 3rpx; background:#a4b58b; }.bar-label { color:#8b9681; font-size:19rpx; }.milestones { display:flex; gap:22rpx; margin-top:36rpx; }.milestones>view { flex:1; background:#f1ecdf; border-radius:24rpx; padding:28rpx; }.local-note { display:block; color:#9a9f91; font-size:21rpx; line-height:1.9; margin:24rpx 0; }
.study-top { font-size:24rpx; margin-bottom:28rpx; }.study-label { margin:40rpx 0 24rpx; text-align:center; font-size:23rpx; color:#9ba38f; }.word-card { background:#fffdf8; padding:30rpx 32rpx 44rpx; border:1rpx solid #eeede3; border-radius:32rpx; box-shadow:0 15rpx 40rpx #dce0d222; min-height:540rpx; }.card-top { margin-bottom:42rpx; }.big-word { display:block; font-size:66rpx; font-weight:600; text-align:center; line-height:1.4; overflow-wrap:anywhere; }.phonetic { display:block; text-align:center; font-size:27rpx; color:#97a18b; margin:18rpx 0; }.meaning { margin:36rpx 0 20rpx; padding-top:30rpx; border-top:1rpx solid #e9ecdf; font-size:29rpx; color:#65735d; line-height:1.95; white-space:pre-wrap; }.hidden-meaning { margin-top:70rpx; text-align:center; color:#b1b7a6; font-size:26rpx; }.study-bottom { margin:40rpx 0; }.primary { padding:26rpx 20rpx; background:#3e604c; color:#fffaf1; font-size:29rpx; border-radius:22rpx; }.secondary { padding:24rpx; background:#edf0e6; color:#5f7858; margin-top:30rpx; }.footnote { display:block; font-size:21rpx; color:#9ca590; text-align:center; line-height:1.8; margin:24rpx 0; }.rating-row { display:flex; gap:14rpx; }.rating { flex:1; padding:28rpx 4rpx; font-size:26rpx; }.rating text { display:block; }.again { background:#f3e5dc; color:#9b7462; }.hard { background:#efecdb; color:#948351; }.good { background:#e2ead9; color:#53714c; }.rating-hint { margin-top:10rpx; font-size:18rpx; opacity:.8; }.completion { text-align:center; padding:65rpx 6rpx; }.completion-icon { color:#9dac83; font-size:120rpx; margin-bottom:30rpx; }.quote { margin:44rpx 0; padding:24rpx; font-size:29rpx; line-height:1.9; color:#7d8c71; }
.overlay { position:fixed; inset:0; background:#213a2c66; z-index:20; display:flex; flex-direction:column; justify-content:flex-end; }.sheet { background:#faf8f4; border-radius:36rpx 36rpx 0 0; padding:36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); max-height:90vh; overflow-y:auto; }.detail-word { display:block; text-align:center; font-size:56rpx; margin-top:44rpx; overflow-wrap:anywhere; }.settings-scroll { height:58vh; margin:20rpx 0 28rpx; }.field-label { display:block; color:#78876c; font-size:24rpx; margin:26rpx 0 16rpx; }.field { width:100%; background:#eeeee4; padding:22rpx; height:84rpx; font-size:28rpx; border-radius:16rpx; }.note-input { height:150rpx; line-height:1.8; }.book-option { display:flex; justify-content:space-between; align-items:center; padding:22rpx 18rpx; margin-bottom:12rpx; border:1rpx solid #e1e5d7; border-radius:16rpx; color:#98a287; }.book-option>view { flex:1; }.book-name { display:block; font-size:25rpx; color:#6c7c60; margin-bottom:5rpx; }.book-selected { background:#e8eddf; border-color:#a4b58b; }.backup-row { display:flex; justify-content:space-between; margin-top:24rpx; }.backup-overlay { z-index:30; }.backup-input { width:100%; height:360rpx; background:#eeeee4; border-radius:18rpx; padding:24rpx; font-size:24rpx; line-height:1.7; margin:30rpx 0; }.notice { background:#f2e4d4; color:#8b6047; padding:24rpx; border-radius:20rpx; font-size:23rpx; margin-top:24rpx; }

/* Reserve the same card space before and after revealing the meaning. */
.study-app { padding-bottom:calc(48rpx + env(safe-area-inset-bottom)); }
.word-card { display:flex; flex-direction:column; height:540rpx; min-height:0; }
.word-card .card-top { flex:none; }
.study-card-content { flex:1; min-height:0; }
.study-card-scroll { height:100%; }
.study-top .text-button { flex:none; width:120rpx; margin:0; text-align:left; }
.study-title { flex:1; min-width:0; text-align:center; }
.study-counter { flex:none; width:120rpx; text-align:right; }
.card-top .star { flex:none; width:64rpx; height:64rpx; margin:0 0 0 auto; }
.study-actions { width:100%; margin:28rpx 0 0; }
.study-action-slot { flex:1; min-width:0; }
.study-actions .rating { display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; height:128rpx; margin:0; padding:12rpx 4rpx; }
.study-actions .next-word { background:#3e604c; color:#fffaf1; }
.answer-actions { display:flex; flex-direction:column; gap:16rpx; width:100%; padding-top:20rpx; }
.answer-actions .rating { flex:none; height:96rpx; }
.answer-actions .next-word { height:128rpx; }
.study-pronunciation { width:100%; padding:8rpx 0; font-weight:400; line-height:1.6; background:transparent; }
.study-audio-status { display:block; min-height:30rpx; margin:12rpx 0 0; text-align:center; color:#97a18b; font-size:20rpx; line-height:1.5; }
.study-actions .footnote { height:48rpx; margin:16rpx 0 0; font-size:20rpx; line-height:24rpx; }

.swipe-entry { display:flex; align-items:center; justify-content:space-between; width:100%; margin:24rpx 0 0; padding:26rpx; text-align:left; background:#edf0e6; border:1rpx solid #dfe6d5; border-radius:26rpx; }.swipe-entry-title { display:block; color:#45664c; font-size:31rpx; font-weight:600; margin-bottom:8rpx; }.swipe-entry-arrow { color:#839c70; font-size:40rpx; }

.plan-picker-trigger { display:inline-flex; flex:0 0 auto; align-items:center; justify-content:center; max-width:60%; min-width:0; width:auto; margin:0; padding:10rpx 14rpx; color:#e0e8d7; font-size:23rpx; line-height:1.5; border:1rpx solid #6b846d; border-radius:14rpx; overflow-wrap:anywhere; }
.plan-trigger-pressed { background:#506d59; }
.mode-entries { display:flex; gap:20rpx; margin-top:24rpx; }.mode-entries .swipe-entry { flex:1; width:0; min-width:0; margin:0; padding:26rpx 20rpx; }.mode-entries .muted { font-size:21rpx; }.dictation-entry { background:#f3ece0; border-color:#e9dfce; }
.plan-picker-scroll { height:70vh; margin-top:24rpx; }.plan-grid { display:flex; flex-wrap:wrap; gap:14rpx; }.plan-option { width:calc((100% - 28rpx) / 3); margin:0; padding:20rpx 6rpx; border:1rpx solid #dce5d2; background:#edf1e5; border-radius:18rpx; font-size:26rpx; }.plan-option text { display:block; }.plan-option .muted { font-size:19rpx; }.history-option { width:100%; margin:0 0 14rpx; text-align:left; padding:24rpx; border:1rpx solid #e2e6d9; border-radius:18rpx; font-size:26rpx; }.history-option text { display:block; }

.learned-stat { padding:4rpx 12rpx; border-radius:16rpx; }.learned-stat-pressed { background:#edf0e6; }.learned-library-link { width:100%; text-align:right; margin:16rpx 0 0; }
