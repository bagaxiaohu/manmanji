.swipe-page { max-width:1000rpx; margin:0 auto; padding:28rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); }
.topline,.row { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }.topline { font-size:25rpx; margin-bottom:30rpx; }.back { width:100rpx; margin:0; text-align:left; font-size:25rpx; color:#7b8b70; }.muted { display:block; color:#929d87; font-size:24rpx; line-height:1.8; }.eyebrow { display:block; color:#8b9a7d; font-size:20rpx; letter-spacing:2rpx; }.intro { margin:48rpx 0 32rpx; }.title { font-size:39rpx; line-height:1.6; font-weight:600; margin:18rpx 0; }.counter { color:#909c83; font-size:23rpx; margin:25rpx 0; text-align:center; }
.swipe-card { background:#fffdf8; border:1rpx solid #eeede3; border-radius:32rpx; padding:30rpx; min-height:780rpx; display:flex; flex-direction:column; text-align:center; }.pill { background:#edf0e7; color:#738565; border-radius:12rpx; padding:9rpx 14rpx; font-size:20rpx; }.word { display:block; font-size:63rpx; line-height:1.4; font-weight:600; margin:44rpx 0 12rpx; overflow-wrap:anywhere; }.phonetic { flex:none; width:100%; margin:0; padding:16rpx 0; color:#879b76; font-size:27rpx; }.meaning-block { margin-top:32rpx; border-top:1rpx solid #e9ecdf; }.meaning { display:block; font-size:27rpx; color:#6d7e60; line-height:1.9; white-space:pre-wrap; text-align:left; padding-top:20rpx; }.audio-status { display:block; min-height:36rpx; font-size:20rpx; line-height:1.7; text-align:center; color:#8a9a7c; margin:16rpx 0; }.swipe-hints { display:flex; flex-wrap:wrap; color:#a2ab98; font-size:22rpx; margin:36rpx 0 24rpx; line-height:2; }.swipe-hints text { width:50%; text-align:center; }.button-row { display:flex; gap:16rpx; }.button-row button { flex:1; min-width:0; width:0; }.primary,.soft { width:100%; margin:0; padding:24rpx 18rpx; border-radius:22rpx; font-size:27rpx; }.primary { background:#3e604c; color:#fffaf1; }.soft { background:#eaf0e2; color:#6f855e; }.peach { background:#f3e5dc; color:#a47860; }.secondary-row { margin-top:16rpx; }.flower { font-size:100rpx; color:#9dab85; margin-top:60rpx; }.panel { background:#edf0e6; padding:30rpx; border-radius:28rpx; margin:30rpx 0; line-height:1.9; }.panel .muted { margin-top:20rpx; }.warning { display:block; color:#a57557; font-size:24rpx; margin-top:24rpx; }.empty { color:#8d9a82; padding:90rpx 0; text-align:center; line-height:1.9; }.overview-row { padding:24rpx 0; border-bottom:1rpx solid #e6e9dc; }.overview-word { display:block; width:100%; margin:0; text-align:left; font-size:33rpx; color:#3e604c; }.footnote { display:block; text-align:center; color:#9aa58d; line-height:1.9; font-size:22rpx; margin:24rpx 0; }.listening { text-align:center; }.listen-symbol { display:block; font-size:75rpx; color:#9bad84; margin-bottom:20rpx; }.field { display:block; width:100%; border-radius:20rpx; background:#eeeee4; padding:24rpx; font-size:29rpx; height:92rpx; margin:24rpx 0; }.meaning-input { height:170rpx; line-height:1.8; }.next { margin-top:28rpx; }.result-card { background:#fffdf8; border:1rpx solid #eeede3; padding:28rpx; border-radius:26rpx; margin-bottom:24rpx; }.result-word { font-size:34rpx; overflow-wrap:anywhere; }.badge { flex:none; font-size:20rpx; padding:8rpx 12rpx; border-radius:10rpx; }.ok { color:#6a855b; background:#e7efdb; }.wrong { color:#a46b53; background:#f1e3d7; }.result-card .button-row { margin-top:24rpx; }.chosen { box-shadow:inset 0 0 0 3rpx #90a777; }
.gesture-note { display:block; text-align:center; font-size:20rpx; color:#a2ab98; margin-bottom:12rpx; }
.diagnostic { display:block; margin-top:20rpx; font-size:21rpx; line-height:1.8; color:#9c826a; white-space:pre-wrap; overflow-wrap:anywhere; }
